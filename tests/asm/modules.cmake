set(module_entries)
foreach(codec comper comperx kosinski kosplus)
    if(codec STREQUAL "comper")
        set(DIRECT_INCLUDE "\tinclude \"Comper.asm\"")
        set(MODULE_SOURCE Comper_Moduled.asm)
    elseif(codec STREQUAL "comperx")
        set(DIRECT_INCLUDE "")
        set(MODULE_SOURCE ComperX_Moduled.asm)
    elseif(codec STREQUAL "kosinski")
        set(DIRECT_INCLUDE "\tinclude \"Kosinski.asm\"")
        set(MODULE_SOURCE Kosinki_Moduled.asm)
    else()
        set(DIRECT_INCLUDE "\tinclude \"KosinskiPlus.asm\"")
        set(MODULE_SOURCE KosinkiPlus_Moduled.asm)
    endif()
    foreach(DMA_WORDS RANGE 0 1)
        set(name "module-${codec}-dma${DMA_WORDS}")
        set(wrapper "${image_directory}/${name}.driver.asm")
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/wrappers/moduled.asm.in" "${wrapper}" @ONLY)
        assemble_image(${name} "${wrapper}" ${decoder_sources})
        list(APPEND module_entries "{\"name\":\"${name}\",\"codec\":\"${codec}\",\"source\":\"${MODULE_SOURCE}\",\"dma_source_words\":${DMA_WORDS}}")
    endforeach()
endforeach()
list(JOIN module_entries ",\n" module_json)
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/module_images.json" CONTENT "{\"images\":[\n${module_json}\n]}\n" @ONLY)
