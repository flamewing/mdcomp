cmake_minimum_required(VERSION 3.19)

execute_process(COMMAND "${EXPORTER}" "${OUTPUT_DIRECTORY}" ${EXPORT_ARGS}
    RESULT_VARIABLE status TIMEOUT 20)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Fixture export failed: ${status}")
endif()
file(READ "${MANIFEST}" manifest)
string(JSON expected_count LENGTH "${manifest}" fixtures)
file(STRINGS "${OUTPUT_DIRECTORY}/index.tsv" entries)
list(LENGTH entries actual_count)
if(NOT actual_count EQUAL expected_count)
    message(FATAL_ERROR "Fixture count changed; review and update the manifest")
endif()
foreach(entry IN LISTS entries)
    string(REPLACE "\t" ";" fields "${entry}")
    list(GET fields 0 id)
    list(APPEND identifiers "${id}")
    list(GET fields 1 codec)
    list(GET fields 2 forms)
    string(REPLACE "," ";" forms "${forms}")
    list(APPEND observed_${codec} ${forms})
    foreach(kind IN ITEMS compressed raw)
        file(SHA256 "${OUTPUT_DIRECTORY}/${id}.${kind}" actual)
        string(JSON expected GET "${manifest}" fixtures "${id}" "${kind}_sha256")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Fixture ${id}.${kind} differs from its reviewed manifest")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES identifiers)
list(LENGTH identifiers unique_count)
if(NOT unique_count EQUAL actual_count)
    message(FATAL_ERROR "Fixture export contains duplicate identifiers")
endif()
string(JSON codec_count LENGTH "${manifest}" required_decoder_forms)
math(EXPR last_codec "${codec_count} - 1")
foreach(index RANGE ${last_codec})
    string(JSON codec MEMBER "${manifest}" required_decoder_forms ${index})
    string(JSON form_count LENGTH "${manifest}" required_decoder_forms "${codec}")
    math(EXPR last_form "${form_count} - 1")
    foreach(form_index RANGE ${last_form})
        string(JSON form GET "${manifest}" required_decoder_forms "${codec}" ${form_index})
        if(NOT form IN_LIST observed_${codec})
            message(FATAL_ERROR "Missing declared decoder form: ${codec}/${form}")
        endif()
    endforeach()
endforeach()
